# Gemini API key (required for ops agent + auditor)
GEMINI_API_KEY=

# Circle Agent Wallet address on Base Sepolia
CIRCLE_AGENT_WALLET=0x008ed50be2cd35f6333a37542a76a227e3b16acc

# Chain: BASE-SEPOLIA (testnet) or BASE (mainnet)
CIRCLE_CHAIN=BASE-SEPOLIA

# Private key that pays gas to publish ERC-8004 reputation events on Base
# Sepolia. If unset, on-chain reputation submission is skipped (no fabricated
# tx hash — the writer returns None). Rotate before reuse; keep out of git.
ERC8004_DEPLOYER_KEY=

# Admin bearer token for destructive/administrative endpoints
# (/api/reset-demo and /api/autonomous-check when not called by Cloud
# Scheduler). If unset, those endpoints fail closed and return 401.
VERIGATE_ADMIN_TOKEN=

# Treasury and validator wallet addresses (optional overrides)
VERIGATE_TREASURY_WALLET=0x0c744ecb3949b3582cdd2dbc70dc876405eec44d
VALIDATOR_WALLET_ADDRESS=0xbe1424b7bcc149523f749ceb7a8316d8ba6ba558

# GCS bucket for proof bundles + singleton state (sanctions cache,
# behavioral history). Set VERIGATE_GCS_ENABLED=0 to force the local
# ./cache/ fallback (offline/tests). Both have safe defaults.
VERIGATE_BUCKET=verigate-proof-bundles
VERIGATE_GCS_ENABLED=1
